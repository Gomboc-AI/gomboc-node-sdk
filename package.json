{
  "name": "gomboc-node-sdk",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node --watch dist/index.js",
    "dev": "node --watch dist/index.js",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format:write": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "generate-types": "openapi-typescript ./openApiClientSpecs/rules-service.openapi.yaml --o ./src/__generated__/rulesService.d.ts",
    "release": "npm run build && changeset publish",
    "clean": "rm -rf dist",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gomboc-ai/gomboc-node-sdk.git"
  },
  "license": "ISC",
  "keywords": [
    "rules",
    "sdk",
    "node",
    "typescript"
  ],
  "author": "Gomboc AI",
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/gomboc-ai/gomboc-node-sdk/issues"
  },
  "homepage": "https://github.com/gomboc-ai/gomboc-node-sdk#readme",
  "description": "",
  "dependencies": {
    "axios": "^1.14.0",
    "husky": "^9.1.7",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.0",
    "openapi-typescript": "^7.8.0",
    "prettier": "^3.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.0.0"
  }
}
