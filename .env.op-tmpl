# Copy to .env (gitignored) and fill values, or use 1Password CLI:
#   op inject -i .env.op-tmpl -o .env
#
# Local integration tests: npm run test:integration
# CI/CD never runs these (skipped when CI=true or GITHUB_ACTIONS=true).

# Required for live GET tests against the rules service
RULES_SDK_INTEGRATION=1

# Bearer JWT (Frontegg tenant access token). Store the secret in 1Password; use op:// references below.
RULES_SDK_INTEGRATION_TOKEN="FILL IN PAT"

RULES_SDK_INTEGRATION_BASE_URL=https://rules.dev.gcp.gomboc.ai
